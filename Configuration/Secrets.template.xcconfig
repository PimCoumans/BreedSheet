//
//  Secrets.template.xcconfig
//  BreedSheet
//
//  Copy this file to `Secrets.xcconfig` (same folder) and fill in your own values.
//  `Secrets.xcconfig` is git-ignored so real credentials never get committed.
//

CAT_API_KEY = your_cat_api_key_here

// `//` starts a comment anywhere in an .xcconfig file, even inside a URL — the empty
// macro `$()` splits the slashes so the literal text isn't seen as a comment marker.
CAT_API_BASE_URL = https:/$()/api.thecatapi.com/v1
